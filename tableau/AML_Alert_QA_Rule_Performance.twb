</datasource>
<datasource caption='QA Reviews' inline='true' name='qa'>
<connection class='textscan' directory='../data/processed' filename='qa_reviews.csv' separator=',' />
</datasource>
<datasource caption='Rule Performance' inline='true' name='rules'>
<connection class='textscan' directory='../data/processed' filename='rule_performance.csv' separator=',' />
</datasource>
</datasources>
<worksheets>
<worksheet name='Alert Trend'/>
<worksheet name='False Positive Rate'/>
<worksheet name='QA Pass Rate'/>
<worksheet name='Alert Aging Heatmap'/>
<worksheet name='Volume vs Escalation'/>
<worksheet name='Rule Review Priority'/>
</worksheets>
<dashboards>
<dashboard name='AML QA Executive Dashboard'/>
<dashboard name='Rule Performance Workbench'/>
</dashboards>
</workbook>